# ─────────────────────────────────────────
#  VFX SOTA Monitor - Environment Variables
# ─────────────────────────────────────────

# Database (기본: 로컬 SQLite 파일, 수정 불필요)
# DATABASE_URL=sqlite+aiosqlite:///./data/vfx_sota.db

# Admin token (AI Cluster Worker가 사용할 공유 시크릿)
ADMIN_TOKEN=change-me-to-random-string

# GitHub API (https://github.com/settings/tokens - Fine-grained, public repo read)
GITHUB_TOKEN=

# HuggingFace (선택, https://huggingface.co/settings/tokens)
HF_TOKEN=

# Reddit API (https://www.reddit.com/prefs/apps → script 앱 만들기)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=vfx-sota-monitor by u/yourname

# Frontend (Vite)
VITE_API_URL=http://localhost:8001
